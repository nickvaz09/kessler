# Kessler environment - copy to .env (git-ignored) and fill in.
# Load into your shell before running the server or pipeline:
#   set -a; source .env; set +a

# Space-Track.org credentials (free account: https://www.space-track.org)
# When set, the ingestion pipeline pulls real public CDMs (source='spacetrack').
SPACETRACK_IDENTITY=you@example.com
SPACETRACK_PASSWORD=

# Full catalog: also pull the entire public Space-Track GP catalog (~32k
# objects) each ingest. Needs the credentials above. Recommended - CelesTrak's
# 'active' group now blocks scripted clients, so CelesTrak-only runs are small.
#KESSLER_FULL_CATALOG=1

# Skip Space-Track's public CDMs but keep the catalog (set this on a public
# server: Space-Track allows sharing element sets with a citation, not CDMs).
#KESSLER_SPACETRACK_CDMS=0

# Anthropic API key for the Kessler AI assistant.
# Not needed if you are logged in via `ant auth login` in the same shell.
#ANTHROPIC_API_KEY=

# ElevenLabs key for simulator narration voice.
#ELEVENLABS_API_KEY=
# Optional: override the narration voice (defaults to 'Sarah', which is
# available on free-tier keys; library voices need a paid plan).
#ELEVENLABS_VOICE_ID=

# Auto-refresh: re-run the ingestion pipeline every N hours (float > 0).
# Unset = scheduler off.
#KESSLER_REFRESH_INTERVAL_H=6

# Watch Mode: after each scheduled refresh, run one AI change-of-watch pass
# into the watch log (needs ANTHROPIC_API_KEY; costs real API tokens).
#KESSLER_WATCH_MODE=1

# Postgres (optional - defaults to SQLite at data/kessler.db when unset)
#KESSLER_DATABASE_URL=postgresql://kessler:kessler@localhost:5432/kessler

# Expose dev-only endpoints (POST /ingest/refresh) - leave unset in production.
#KESSLER_DEV_ENDPOINTS=1
